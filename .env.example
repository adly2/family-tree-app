# Copy to `.env` and fill in. `.env` is gitignored and never committed.
#
# This one file has TWO separate readers:
#   1. docker-compose.yml, for ${VAR} substitution (Compose auto-reads a .env
#      sitting next to it)
#   2. Django's settings, via django-environ

# --- Postgres ---
POSTGRES_DB=familytree
POSTGRES_USER=familytree
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django (filled in during unit 3) ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
